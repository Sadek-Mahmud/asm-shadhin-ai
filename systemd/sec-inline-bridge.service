[Unit]
Description=AI Inline Hardware Security Bridge & Network Forwarding
After=network-pre.target
Before=network.target sec-monitor.service suricata.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/ai-security-system
ExecStart=/opt/ai-security-system/scripts/setup_inline_bridge.sh ${WAN_INTERFACE} ${LAN_INTERFACE} ${BRIDGE_NAME}

# Sandboxing
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
